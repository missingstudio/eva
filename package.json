{
  "name": "eva",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugins/*"
    ],
    "catalog": {
      "@tailwindcss/vite": "4.3.3",
      "@types/node": "22.20.1",
      "commander": "15.0.0",
      "effect": "4.0.0-rc.109",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vitest": "4.1.10",
      "yaml": "2.9.0",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "test": "vp test",
    "test:watch": "vp test watch",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "pack": "vp run -r pack",
    "hooks:setup": "vp config",
    "eva": "bun apps/cli/src/eva.ts",
    "rehearse": "bun scripts/release/snapshot.ts",
    "verify": "vp check && vp test && vp run -r pack && bun audit --audit-level=high"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "0.2.8",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.0"
}
