{
  "name": "eva",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "plugins/*"
    ],
    "catalog": {
      "@tailwindcss/vite": "4.3.3",
      "@cloudflare/vite-plugin": "1.52.0",
      "@tanstack/react-router": "1.170.27",
      "@tanstack/react-start": "1.168.44",
      "@tanstack/start-static-server-functions": "1.167.27",
      "@types/mdx": "2.0.14",
      "@types/node": "22.20.1",
      "@types/react": "19.2.18",
      "@types/react-dom": "19.2.4",
      "@vitejs/plugin-react": "6.0.5",
      "commander": "15.0.0",
      "effect": "4.0.0-rc.109",
      "lucide-react": "1.33.0",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "sonner": "2.0.8",
      "tailwindcss": "4.3.3",
      "typescript": "7.0.2",
      "vite": "8.2.1",
      "vitest": "4.1.10",
      "wrangler": "4.122.0",
      "yaml": "2.9.0",
      "zod": "4.4.3"
    }
  },
  "type": "module",
  "scripts": {
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "staged": "vp staged",
    "test": "vp test",
    "test:watch": "vp test watch",
    "dev": "vp run -r dev",
    "build": "vp run -r build",
    "edge": "bun scripts/vercel-config.ts",
    "pack": "vp run -r pack",
    "hooks:setup": "vp config",
    "eva": "bun apps/cli/src/eva.ts",
    "design:lint": "bunx @google/design.md@0.4.0 lint docs/design.md",
    "rehearse": "bun scripts/release/snapshot.ts",
    "verify": "vp check && vp test && vp run -r pack && bun audit --audit-level=high"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "catalog:",
    "dedent": "^1.7.2",
    "typescript": "catalog:",
    "vite-plus": "0.2.8",
    "vitest": "catalog:"
  },
  "engines": {
    "bun": ">=1.4.0",
    "node": ">=22.13"
  },
  "packageManager": "bun@1.4.0"
}
