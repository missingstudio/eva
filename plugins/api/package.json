{
  "name": "@missingstudio/eva-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./client": {
        "types": "./dist/client/index.d.mts",
        "default": "./dist/client/index.mjs"
      }
    }
  },
  "scripts": {
    "pack": "vp pack src/index.ts src/client/index.ts"
  },
  "dependencies": {
    "@missingstudio/eva-client-runtime": "workspace:*",
    "@missingstudio/eva-core": "workspace:*",
    "@missingstudio/eva-schema": "workspace:*",
    "@missingstudio/eva-sdk": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}
